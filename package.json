{
  "name": "retail-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Retail Management System",
  "keywords": [
    "turborepo",
    "typescript",
    "nextjs",
    "nestjs",
    "retail-management-system"
  ],
  "author": "Bovilius Meidi <boviliusbm@gmail.com>",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
